# Every integration falls back to a labelled mode when its keys are missing.

# Postgres (Neon). Without it the app keeps runs in memory (lost on restart).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Gemini drafts the planner brief from the engine's output. Without it, a template brief is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Telegram: procurement group that gets "new run, N reorders waiting" with a link. Without it, simulated and logged.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack incoming webhook for run alerts and early warnings. Without it, simulated and logged.
SLACK_WEBHOOK_URL=

# Public URL, used for the Telegram button. Defaults to the Vercel production URL.
APP_URL=

# Evaluation date for the bundled SAP sample export that seeds the first run.
CASE_EVALUATION_DATE=2026-10-22
